---
import TrustPageShell from '../../components/TrustPageShell.astro';
import { TRUST_CONTENT } from '../../content/trust';
import { useTranslations } from '../../i18n/ui';

const lang = 'zh';
const t = useTranslations(lang);
---

<TrustPageShell
  lang={lang}
  path="/zh/terms/"
  enPath="/terms/"
  zhPath="/zh/terms/"
  title={t('trust.terms.title')}
  description={t('trust.terms.description')}
  body={TRUST_CONTENT.terms.zh}
/>
